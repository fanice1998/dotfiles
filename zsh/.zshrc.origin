# ===== 基本設定 =====
export HISTFILE=~/.zsh_history
export HISTSIZE=50000
export SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

# ===== 語系（locale）=====
# 終端機/系統常帶進殘缺的 LC_CTYPE=UTF-8（不是完整 locale 名稱）。bash 3.2 無法
# 解析它、退回 C ctype 後就看不到多位元組邊界，CJK 標點旁的 $var 展開會把位元組
# 吃進變數名（例：$id：→ id\xef），在 set -u 下變成 unbound variable。這裡設成
# 完整 UTF-8 locale，並清掉會蓋過 LANG 的殘缺變數，讓所有子行程都繼承正確語系。
export LANG=zh_TW.UTF-8
unset LC_ALL LC_CTYPE

# ===== ssh-agent（固定 socket，所有終端機共用一個 agent）=====
# 指到固定路徑，開任何終端機都用同一個 agent，密碼整個登入階段只要打一次。
# ssh-add -l 的離開碼：0 有金鑰、1 agent 在但沒金鑰、2 連不到 agent。
# 只有連不到（2）時才重開，避免把已在跑、只是還沒載入金鑰的 agent 砍掉。
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
ssh-add -l &>/dev/null
if [ $? -eq 2 ]; then
  rm -f "$SSH_AUTH_SOCK"
  eval "$(ssh-agent -a "$SSH_AUTH_SOCK")" >/dev/null
fi

# ===== PATH 集中管理 =====
# path 陣列與 PATH 連動；typeset -U 自動去除重複項（重複 source 也不會疊加）。
# 只把實際存在的目錄加到最前面（靠前的優先）。刻意不用 glob qualifier (N-/)：
# 那寫法在 bareglobqual 關閉的狀態（例如 ksh 模擬）下 source 會報 bad pattern。
export GOPATH="${GOPATH:-$HOME/go}"
typeset -U path PATH
# .local/bin：本地執行檔（starship、fd…）/usr/local/go/bin：go 本體/$GOPATH/bin：go install 的工具
typeset -a _add
for _dir in "$HOME/.local/bin" /usr/local/go/bin "$GOPATH/bin"; do
  [[ -d $_dir ]] && _add+=($_dir)
done
path=($_add $path)
unset _dir _add

# ===== 補全（cd 提示的關鍵）=====
autoload -Uz compinit
compinit -C                    # -C 加快啟動速度
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
# WSL 的 /mnt/c 目錄都是 777，預設 ow/tw 是藍字綠底看不清楚，改成跟一般目錄一樣
export LS_COLORS="${LS_COLORS}:ow=01;34:tw=01;34"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# ===== 插件 =====
source ~/.zsh/fzf-tab/fzf-tab.plugin.zsh
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Autosuggestions 設定（灰色提示）
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# history 不看當前目錄，cd 改用 completion 才會依當前目錄提示
ZSH_AUTOSUGGEST_HISTORY_IGNORE='cd *'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# ===== 按鍵綁定 =====
# 上/下鍵做 history search，並自動把游標移到行尾
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end

# 刻意用 emacs 模式（不用 vi 模式）。emacs 沒有「命令模式」，落單的 ESC 只是 meta
# 前綴、會等下一個鍵，永遠不會像 vi 模式那樣因某個 escape 序列沒綁好、或 KEYTIMEOUT
# 到期就把你切進命令模式（那會讓之後打的字母被當 vi 指令而刪字）。只需一套 keymap。
bindkey -e

# 上下鍵搜尋指令歷史紀錄
# 一般模式是 Esc [ A/B；應用游標模式是 Esc O A/B（字母 O）
bindkey '^[[A' history-beginning-search-backward-end
bindkey '^[[B' history-beginning-search-forward-end
bindkey '^[OA' history-beginning-search-backward-end
bindkey '^[OB' history-beginning-search-forward-end

# 依字移動（word）：macOS Rio 的 Option+←/→ 送出 ^[b / ^[f（實測確認），等同 emacs
# 的 Meta-b / Meta-f（backward/forward-word，emacs 預設即綁，這裡明示）；另補上
# Windows/Linux 常見的 Ctrl+←/→（^[[1;5D/C）與其他終端機的 Option/Alt（^[[1;3D/C）。
bindkey '^[b'     backward-word
bindkey '^[f'     forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word

# 行首 / 行尾：emacs 預設已有 ^A / ^E。這裡補 Home/End 鍵；mac 的 Cmd+←/→ 由 Rio
# 綁定送出 Home(^[[H) / End(^[[F)（見 rio/config.toml.tmpl 的 [bindings]）。
bindkey '^[[H'  beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[OH'  beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[OF'  end-of-line

# Delete / Ctrl+Delete / Ctrl+Backspace / Option+Backspace
bindkey '^[[3~'     delete-char
bindkey '^[[3;5~'   kill-word
bindkey '^H'        backward-kill-word
bindkey '^[[127;5u' backward-kill-word
bindkey '^[^?'      backward-kill-word

# Shift+Tab：反向選單補全
bindkey '^[[Z' reverse-menu-complete

# ===== 常用 alias =====
# ls 預設不上色，要自己加旗標或設 alias。有 eza 就換 eza（本身就帶色）。
if command -v eza &>/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lah --group-directories-first --git'
elif ls --version &>/dev/null; then   # GNU ls（Linux）
  alias ls='ls --color=auto'
  alias ll='ls -lah --color=auto'
else                                   # BSD ls（macOS）
  alias ls='ls -G'
  alias ll='ls -lahG'
fi
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph -15'

# ===== 工具鏈 / Tooling =====
# Go 由上面「PATH 集中管理」統一處理（/usr/local/go/bin 與 $GOPATH/bin 存在才加），
# 不另外跑 `go env`，避免沒有 go 時報錯；GOROOT 交給 go 自行偵測。

# Rust / cargo (hx, steel, forge, rust-analyzer)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"

# flutter SDK
export PATH="$HOME/develop/flutter/bin:$PATH"

# Android PATH
export JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null || echo /opt/homebrew/opt/openjdk@17)"
export ANDROID_HOME="/opt/homebrew/share/android-commandlinetools"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<

# Added by cua-driver-rs installer — see https://github.com/trycua/cua
export PATH="/Users/fanice/.local/bin:$PATH"

# starship 提示字元（放最後，確保初始化時 PATH 已完整）
eval "$(starship init zsh)"
